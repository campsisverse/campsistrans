[MAIN]
KA=THETA_KA * exp(ETA_KA)
CL=THETA_CL * exp(ETA_CL)
Vc=THETA_Vc * exp(ETA_Vc)
Vp1=THETA_Vp1 * exp(ETA_Vp1)
Vp2=THETA_Vp2 * exp(ETA_Vp2)
q1=THETA_q1 * exp(ETA_q1)
Q2=THETA_Q2 * exp(ETA_Q2)
SCALE2=Vc

[ODE]
d/dt(A_DEPOT)=-KA*A_DEPOT
d/dt(A_CENTRAL)=KA*A_DEPOT + q1*A_PERIPHERAL1/Vp1 + Q2*A_PERIPHERAL2/Vp2 + (-CL/Vc - q1/Vc - Q2/Vc)*A_CENTRAL
d/dt(A_PERIPHERAL1)=-q1*A_PERIPHERAL1/Vp1 + q1*A_CENTRAL/Vc
d/dt(A_PERIPHERAL2)=-Q2*A_PERIPHERAL2/Vp2 + Q2*A_CENTRAL/Vc
d/dt(A_OUTPUT)=CL*A_CENTRAL/Vc
F=A_CENTRAL/SCALE2

[ERROR]
CONC=F
CONC_ERR=CONC * (1 + EPS_RUV1)
Y=CONC_ERR

